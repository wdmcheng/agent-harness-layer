# Agent Harness Layer service-app 模板
# `.env` 是 profile YAML 之上的本机覆盖层；不要把真实 token 或 provider key 提交。
AGENT_HARNESS_PROFILE=local
AGENT_HARNESS_CONFIG=configs/profiles/local.yaml
AGENT_HARNESS_STORAGE__ROOT=.agent-harness/local
AGENT_HARNESS_OBSERVABILITY__PATH=.agent-harness/traces.jsonl
AGENT_HARNESS_AUTH__PROVIDER=local
AGENT_HARNESS_AUTH__REQUIRED=false
AGENT_HARNESS_AUTH__DEV_BEARER_TOKEN=
# local 默认开启文档，service 默认关闭。正式环境排障时可临时取消下一行注释，
# 结束后恢复关闭；一个开关同时控制 OpenAPI、Swagger、Redoc 和本地静态 mount。
# AGENT_HARNESS_SERVICE__API_DOCS__ENABLED=true
# 文档开启时默认使用模板内锁定资源。只有浏览器可出网且明确希望从 CDN
# 加载时才改为 online；两种模式使用同一锁定版本。
AGENT_HARNESS_SERVICE__API_DOCS__ASSET_MODE=offline
AGENT_HARNESS_POLICY__PROVIDER=yaml
AGENT_HARNESS_POLICY__PATH=configs/policy/default.yaml
AGENT_HARNESS_MODEL__PROVIDER=fake
AGENT_HARNESS_MODEL__REQUIRES_API_KEY=false
# 真实文本模型必须先把 configs/examples/real-text-model.fragment.yaml 按维护说明合并进
# 受控 profile，声明 deployment、endpoint policy、model catalog 与 credential ref；
# 这里只展示隔离 secret file 的注入形状，默认保持注释和离线。
# AGENT_HARNESS_MODEL__DEFAULT_DEPLOYMENT_ID=real_primary
# AGENT_HARNESS_MODEL__CREDENTIALS__REAL_PRIMARY_KEY__VALUE_FILE=.agent-harness/secrets/model-real-primary-key
# direct value 与上述 `_FILE` 同时存在会在读文件前失败；不要设置 OPENAI_API_KEY、
# OPENAI_BASE_URL 或 proxy 变量来绕过 typed route，它们不会成为 Harness 配置来源。
# live smoke 还需要当前会话单独授权和下列显式 opt-in；普通 local/CI 永远不设置。
# AGENT_HARNESS_LIVE_MODEL_OPT_IN=1
# AGENT_HARNESS_LIVE_MODEL_AUTHORIZED=1
AGENT_HARNESS_IDENTITY__DEFAULT__TENANT_ID=default
AGENT_HARNESS_IDENTITY__DEFAULT__USER_ID=local-user

# 必填：为每个环境安全生成，并在同一状态库生命周期内保持稳定。不要提交真实值。
# 生成示例：uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
AGENT_HARNESS_BUDGET__FINGERPRINT_KEY=

# local profile 只使用 fake/local provider，不需要真实模型或 provider key；上面的
# fingerprint key 是预算幂等/恢复所需的本地 secret，不能留空启动。
# 真实 provider key 应通过本机 `.env` 或部署环境变量注入，不进入模板默认值。

# service profile 的应用 DSN 通过 Compose read-only secret 挂载；这里仅保存宿主机路径。
# 启动前可执行：mkdir -p .agent-harness/secrets && chmod 700 .agent-harness/secrets
# 再把 DSN 写入下列文件并 chmod 600；成功、失败或中断后都要删除该临时文件。
SERVICE_APP_STORAGE_DSN_FILE=.agent-harness/secrets/storage-dsn
# PostgreSQL 官方镜像也通过 POSTGRES_PASSWORD_FILE 消费独立只读 secret，避免
# `docker compose config` 把数据库密码展开为环境变量值。
SERVICE_APP_POSTGRES_PASSWORD_FILE=.agent-harness/secrets/postgres-password
# 清理命令：rm -f .agent-harness/secrets/storage-dsn .agent-harness/secrets/postgres-password
