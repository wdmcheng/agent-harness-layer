#!/usr/bin/env bash
# Generated by Agent Pack launcher. Do not edit by hand.
set -euo pipefail

project_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
lock="$project_dir/.agents/agent-pack.lock.json"

read_pack_dir() {
  local code='import json, os, sys; p=sys.argv[1]; print(json.load(open(p, encoding="utf-8")).get("packPath","") if os.path.exists(p) else "")'
  if command -v python3 >/dev/null 2>&1; then python3 -c "$code" "$lock"; return; fi
  if command -v python >/dev/null 2>&1; then python -c "$code" "$lock"; return; fi
  if command -v py >/dev/null 2>&1; then py -3 -c "$code" "$lock"; return; fi
}

if [ "${1:-}" = "migrate" ] && [ "${2:-}" = "--pack" ] && [ -n "${3:-}" ]; then
  pack_dir="$3"
else
  pack_dir="$(read_pack_dir)"
fi
if [ -z "$pack_dir" ]; then echo 'Error: missing .agents/agent-pack.lock.json; cannot locate Agent Pack.' >&2; exit 1; fi

cd "$project_dir"
exec "$pack_dir/agent-pack" "$@"
